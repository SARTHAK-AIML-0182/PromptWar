# =================================================================
# Startup Co-Pilot Configuration (.env)
# =================================================================

# Server Port
PORT=8000

# LLM Provider Configuration
# Supported options: "gemini" (default), "openai", "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (Default)
# If left empty, system operates in offline High-Fidelity Mock Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web Research Tool (Optional)
# If left empty, system uses curated offline industry knowledge cache
TAVILY_API_KEY=
